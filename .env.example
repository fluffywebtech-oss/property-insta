# PropertyInsta — environment variables
# Copy this file to `.env.local` and fill in real values. Never commit `.env.local`.

# ============================================================================
# Supabase (frontend — public anon key, safe to expose by design)
# ============================================================================
# Defaults to a working dev project in src/lib/supabase.js, so you only need
# to override when pointing at your own Supabase instance.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key

# ============================================================================
# AI Copilot — Anthropic Claude (server-only key)
# ============================================================================
# Used by the Vercel serverless function at api/chat.js. NEVER prefix with
# VITE_ — Vite would ship it to the browser and expose your key.
#
# Get a key from https://console.anthropic.com → API Keys.
# Without this set, the AI Copilot falls back to its built-in rule-based
# intent matcher — the chat still works, just less flexible.
ANTHROPIC_API_KEY=sk-ant-api03-...your-key...

# ============================================================================
# Google Maps (optional — upgrades MapView to Google's basemap)
# ============================================================================
# Get a key from https://console.cloud.google.com (enable Map Tiles API +
# Maps JavaScript API; restrict to your domains before production).
# VITE_GOOGLE_MAPS_API_KEY=
